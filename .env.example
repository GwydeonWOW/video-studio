# Copia a .env y ajusta. NUNCA pongas las claves de IA aquí: se guardan
# cifradas en el volumen desde la pestaña Configuración → Claves.

# URL pública canónica del servicio (habilita el chequeo de Origin en
# las mutaciones; en Coolify es el dominio que le asignes a la app).
ESTUDIO_ORIGEN=

# Orígenes extra permitidos para mutaciones, separados por coma.
ESTUDIO_ORIGENES=

# Usuario del login integrado.
ESTUDIO_USUARIO=estudio

# Opcional: hash scrypt de la contraseña (formato salt$hash, hex).
# Déjalo vacío para usar el flujo de primera instalación por la interfaz.
ESTUDIO_HASH=

# Carpeta de datos persistente (dentro del contenedor es /datos).
# ESTUDIO_DATOS=/datos

# Puerto del contenedor (Coolify mapea el 8000 por defecto).
# ESTUDIO_PUERTO=8000

# Desactivar el login SOLO en desarrollo local. NUNCA en producción.
# ESTUDIO_SIN_LOGIN=0

# Trabajos de render en paralelo (por defecto, mitad de las CPUs).
# ESTUDIO_LOTES=4

# Tope de duración de un trabajo completo, en segundos (7 h por defecto).
# ESTUDIO_TOPE_TRABAJO=25200

# Calidad de imagen por defecto para proyectos nuevos: low | medium | high.
# ESTUDIO_CALIDAD_IMAGEN=low
